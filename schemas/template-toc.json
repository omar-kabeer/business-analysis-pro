{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omar-kabeer/business-analysis-pro/schemas/template-toc.json",
  "title": "Template table-of-contents manifest",
  "description": "The sections of one template and when each applies. See docs/depth-standard.md. scripts/validate-assets.mjs enforces the cross-file rules this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artefactType", "sections"],
  "properties": {
    "$comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "artefactType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "tier", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "heading": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["core", "standard", "extended"] },
          "purpose": { "type": "string", "minLength": 1 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "approach": { "type": "array", "items": { "enum": ["predictive", "adaptive", "hybrid"] } },
              "formality": { "type": "array", "items": { "enum": ["light", "standard", "formal"] } },
              "audience": { "type": "array", "items": { "enum": ["executive", "delivery", "regulator", "customer"] } },
              "risk": { "type": "array", "items": { "enum": ["low", "medium", "high"] } },
              "regulated": { "type": "array", "items": { "const": true } },
              "domainPack": { "type": "array", "items": { "type": "string" } },
              "perspective": {
                "type": "array",
                "items": {
                  "enum": [
                    "agile",
                    "business-intelligence",
                    "information-technology",
                    "business-architecture",
                    "business-process-management"
                  ]
                }
              }
            }
          },
          "requires": { "type": "array", "items": { "type": "string" } },
          "evidences": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "artefactStandard": {
            "enum": ["purpose", "scope", "inputs", "outputs", "assumptions", "risks", "review-criteria"]
          }
        }
      }
    }
  }
}
